# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/catalog
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/catalog

# --- Neon (Postgres) ---
# Workspace role — RLS-enforced. App code uses this inside withWorkspace().
DATABASE_URL=
# Service role — RLS bypass. Required for first-login workspace bootstrap.
DATABASE_URL_SERVICE=

# --- Sigmafy stats engine (Python) ---
# Base host (no /api prefix). The gateway builds /api/v1/<slug-path> internally.
STATS_API_BASE_URL=https://sigmafy-tools.fly.dev
# Bearer token sent to the Python API. Empty = anonymous (dev only; the
# Python service must have SIGMAFY_API_KEYS=[] for that to work).
STATS_API_SIGNING_SECRET=
